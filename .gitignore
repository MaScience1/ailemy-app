# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# output of scripts/bulk-import-papers.ts
bulk-import-report.json

# bytecode from scripts/watermark2.py, written whenever the batch script
# imports it
__pycache__/
*.pyc

# typescript
*.tsbuildinfo
next-env.d.ts

# Python bytecode. A stale __pycache__ once kept a restored test failing —
# "accept" and "reject" are the same length, so the source size never changed.
__pycache__/
*.pyc

# Lesson deck bundles — regenerable derivatives of the founder's source PPTXs
# (scripts/lesson-ingest/ingest.py). Sources live outside the repo; rendered
# frames are megabytes of PNG; neither belongs in git. Tests that need a bundle
# use the skip channel (exit 2) when this directory is absent, same as
# schema-probe does for .env.local.
content/
